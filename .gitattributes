# Cizí knihovny s otiskem SRI: git nesmí měnit konce řádků (core.autocrlf=true by při checkoutu na Windows dal LF→CRLF,
# otisk by nesedl a prohlížeč knihovnu zablokuje — appka nenaběhne). Zjištěno 2026-10-10 (CODE-read) v čisté kopii pro pre-push smoke.
v2/vendor/** -text
*.woff2 binary

# Shell skripty hooků Claude Code (hooks/claude, od 2026-10-14): bash s CRLF nejede ($'\r': command not found) — vždy LF.
hooks/claude/*.sh text eol=lf
