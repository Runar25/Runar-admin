{
 "poznamka": "Texty ownerovych cteni NEJSOU v repu (verejne) — jen zmeny korektoru a verdikty overeni.",
 "cteni": 30,
 "zmeneno_textu": 15,
 "zmeny": [
  {
   "id": "Z1",
