{
 "pravidlo": "význam = 2/2 EN a 2/2 IS (4/4)",
 "obrazy": [
  {
   "id": "Hagalaz:The squall strikes",
   "sk": "H",
   "runa": "Hagalaz",
   "en": "The squall strikes out of a clear sky and is gone just as fast.",
   "is": "Élið skellur á úr heiðskíru og er farið jafn skjótt."
  },
  {
   "id": "Hagalaz:The hail hammers",
   "sk": "H",
   "runa": "Hagalaz",
   "en": "The hail hammers the roof and melts in an instant.",
   "is": "Haglið lemur þakið og bráðnar á augabragði."
  },
  {
   "id": "Hagalaz:In the night the gale",
   "sk": "H",
   "runa": "Hagalaz",
   "en": "In the night the gale tore the old fence down, and the field lies open.",
   "is": "Í nótt reif rokið gömlu girðinguna niður og túnið liggur opið."
  },
  {
   "id": "Hagalaz:The power goes out",
   "sk": "H",
   "runa": "Hagalaz",
   "en": "The power goes out in the storm, and everything that runs by itself stops.",
   "is": "Rafmagnið fer af í óveðrinu og allt sem gengur sjálfkrafa stöðvast."
  },
  {
   "id": "Hagalaz:After the storm",
   "sk": "H",
   "runa": "Hagalaz",
   "en": "After the storm, only the tree with deep roots is still standing.",
   "is": "Eftir óveðrið stendur aðeins tréð sem átti djúpar rætur."
  },
  {
   "id": "Hagalaz:Hail rakes",
   "sk": "H",
   "runa": "Hagalaz",
   "en": "Hail rakes the hayfield in June and is gone before the sky clears.",
   "is": "Haglél lemur túnið í júní og er farið áður en birtir til."
  },
  {
   "id": "Hagalaz:The river swells",
   "sk": "H",
   "runa": "Hagalaz",
   "en": "The river swells overnight and takes with it whatever stood too near the bank.",
   "is": "Áin bólgnar á einni nóttu og tekur með sér það sem stóð of nálægt bakkanum."
  },
  {
   "id": "Ansuz:The raven settles",
   "sk": "C",
   "runa": "Ansuz",
   "en": "The raven settles on the fencepost and waits for you to listen.",
   "is": "Hrafninn sest á staurinn og bíður þess að þú hlustir."
  },
  {
   "id": "Nauthiz:You keep knitting",
   "sk": "C",
   "runa": "Nauthiz",
   "en": "You keep knitting though the yarn is almost out.",
   "is": "Þú prjónar áfram þótt garnið sé við það að klárast."
  },
  {
   "id": "Laguz:The glacial river",
   "sk": "C",
   "runa": "Laguz",
   "en": "The glacial river runs grey and heavy, full of what it carries down from above.",
   "is": "Jökuláin rennur grá og þung, full af því sem hún ber að ofan."
  },
  {
   "id": "Laguz:Water finds its own way",
   "sk": "C",
   "runa": "Laguz",
   "en": "Water finds its own way down the slope, and no one shows it the path.",
   "is": "Vatnið finnur sér leið niður hlíðina, enginn vísar því."
  },
  {
   "id": "Ingwaz:The seed lies",
   "sk": "C",
   "runa": "Ingwaz",
   "en": "The seed lies in the frozen ground and waits for its time.",
   "is": "Fræið liggur í frosinni jörð og bíður síns tíma."
  },
  {
   "id": "Othila:The old farmstead",
   "sk": "C",
   "runa": "Othila",
   "en": "The old farmstead stands in ruins but still holds warmth in memory.",
   "is": "Gamli bærinn stendur í tóftum en heldur enn hita í minningunni."
  },
  {
   "id": "Dagaz:You wake, and dawn",
   "sk": "C",
   "runa": "Dagaz",
   "en": "You wake, and dawn has already changed the light in the room.",
   "is": "Þú vaknar og birtan í herberginu hefur þegar breyst."
  },
  {
   "id": "Isa:The clock on the wall",
   "sk": "C",
   "runa": "Isa",
   "en": "The clock on the wall has stopped and no one has wound it.",
   "is": "Klukkan á veggnum hefur stöðvast og enginn hefur dregið hana upp."
  },
  {
   "id": "Thurisaz:The thorn-bush",
   "sk": "C",
   "runa": "Thurisaz",
   "en": "The thorn-bush stands bare and black in the blizzard, but the spines are still waiting.",
   "is": "Þyrnóttur runninn stendur ber og svartur í hríðinni, en broddarnir bíða enn."
  },
  {
   "id": "Ansuz:The letter comes",
   "sk": "C0",
   "runa": "Ansuz",
   "en": "The letter comes with the boat at last and lies unopened on the table.",
   "is": "Bréfið kemur loks með bátnum og liggur óopnað á borðinu."
  },
  {
   "id": "Ehwaz:When one horse tires",
   "sk": "C0",
   "runa": "Ehwaz",
   "en": "When one horse tires on the climb the other slows unasked, and they reach the ridge together.",
   "is": "Þegar annar hesturinn þreytist í brekkunni hægir hinn á sér óbeðinn, og þeir ná brúninni saman."
  },
  {
   "id": "Ehwaz:On the narrow path",
   "sk": "C0",
   "runa": "Ehwaz",
   "en": "On the narrow path the one who walks with you shortens their stride to yours without a word, and the going evens out.",
   "is": "Á einstiginu styttir sá sem gengur með þér skrefið að þínu án orða, og gangan jafnast."
  },
  {
   "id": "Blank:The line runs down",
   "sk": "C0",
   "runa": "Blank",
   "en": "The line runs down into dark water and nothing has touched it yet.",
   "is": "Handfærið liggur í dökku vatninu og ekkert hefur enn snert það."
  },
  {
   "id": "Raidho:a road vanishing",
   "sk": "C0",
   "runa": "Raidho",
   "en": "a road vanishing round the next bend",
   "is": "Vegurinn hverfur fyrir næstu beygju"
  },
  {
   "id": "Thurisaz:The thorn hedge",
   "sk": "C0",
   "runa": "Thurisaz",
   "en": "The thorn hedge lets nothing through without cost.",
   "is": "Þyrnigerðið hleypir engu í gegn án þess að taka eitthvað í staðinn."
  },
  {
   "id": "T1",
   "sk": "N",
   "runa": "Hagalaz",
   "en": "The storm breaks the window and puts out the candles on the table.",
   "is": "Óveðrið brýtur rúðuna og slekkur á kertunum á borðinu."
  },
  {
   "id": "T2",
   "sk": "N",
   "runa": "Hagalaz",
   "en": "The gale breaks the panes of the greenhouse you built together.",
   "is": "Rokið brýtur rúðurnar í gróðurhúsinu sem þið byggðuð saman."
  },
  {
   "id": "F1",
   "sk": "N",
   "runa": "Fehu",
   "en": "The boat comes in so laden with fish it sits deep in the water.",
   "is": "Báturinn kemur að bryggju svo hlaðinn fiski að hann ristir djúpt."
  },
  {
   "id": "F2",
   "sk": "N",
   "runa": "Fehu",
   "en": "The hot water runs into every house in the valley.",
   "is": "Heita vatnið rennur inn í hvert hús í dalnum."
  },
  {
   "id": "A1",
   "sk": "N",
   "runa": "Algiz",
   "en": "The mountain hut stands open in the blizzard for anyone who needs it.",
   "is": "Sæluhúsið stendur opið í hríðinni fyrir hvern sem þarf."
  },
  {
   "id": "A2",
   "sk": "N",
   "runa": "Algiz",
   "en": "No one touches the stone where the hidden people live.",
   "is": "Enginn hreyfir við steininum þar sem huldufólk býr."
  },
  {
   "id": "W1",
   "sk": "N",
   "runa": "Wunjo",
   "en": "In the hot pot under the frost, everyone laughs at the same story.",
   "is": "Í heita pottinum í frostinu hlæja allir að sömu sögunni."
  },
  {
   "id": "W2",
   "sk": "N",
   "runa": "Wunjo",
   "en": "The dog runs to meet you at the gate and cannot stop wagging.",
   "is": "Hundurinn hleypur á móti þér að hliðinu og getur ekki hætt að dilla skottinu."
  },
  {
   "id": "B1",
   "sk": "N",
   "runa": "Berkana",
   "en": "On the windowsill the seedlings stretch toward the light.",
   "is": "Á gluggakistunni teygja smáplönturnar sig að birtunni."
  },
  {
   "id": "B2",
   "sk": "N",
   "runa": "Berkana",
   "en": "You water the cutting and then leave it alone.",
   "is": "Þú vökvar græðlinginn og lætur hann svo í friði."
  }
 ],
