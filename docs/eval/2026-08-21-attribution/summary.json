 {
  "lang": "is",
  "paka": "uhel[0]",
  "pool": "uhel",
  "idx": 0,
  "n": 8,
  "text": "Byrjaðu á allri myndinni í einu, láttu svo allt hverfa nema eitt.",
  "chlad": 2,
  "smysl": 0,
  "slov": 40,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "uhel[1]",
  "pool": "uhel",
  "idx": 1,
  "n": 8,
  "text": "Byrjaðu á minnsta hlutnum í myndinni, þeim sem flestir gengju fram hjá.",
  "chlad": 1,
  "smysl": 0,
  "slov": 42,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "uhel[2]",
  "pool": "uhel",
  "idx": 2,
  "n": 8,
  "text": "Byrjaðu á hreyfingunni sem er þegar hafin í myndinni. Ef ekkert hreyfist, byrjaðu þá á kyrrðinni sjálfri.",
  "chlad": 0,
  "smysl": 0,
  "slov": 42,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "uhel[3]",
  "pool": "uhel",
  "idx": 3,
  "n": 8,
  "text": "Byrjaðu á því eina í myndinni sem stendur fast meðan allt annað lætur undan.",
  "chlad": 5,
  "smysl": 0,
  "slov": 36,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "uhel[4]",
  "pool": "uhel",
  "idx": 4,
  "n": 8,
  "text": "Byrjaðu á því sem myndin felur undir yfirborðinu, óséð enn.",
  "chlad": 4,
  "smysl": 2,
  "slov": 41,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "uhel[5]",
  "pool": "uhel",
  "idx": 5,
  "n": 8,
  "text": "Byrjaðu á jaðri myndarinnar, þar sem eitt verður að öðru.",
  "chlad": 4,
  "smysl": 0,
  "slov": 40,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "uhel[6]",
  "pool": "uhel",
  "idx": 6,
  "n": 8,
  "text": "Byrjaðu á því að setja leitandann inn í myndina, á staðinn þar sem hún gerist.",
  "chlad": 2,
  "smysl": 0,
  "slov": 41,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "zakonceni_open[0]",
  "pool": "zakonceni_open",
  "idx": 0,
  "n": 8,
  "text": "Endaðu á einni opinni spurningu sem snýr leitandanum inn á við.",
  "chlad": 3,
  "smysl": 0,
  "slov": 41,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "zakonceni_open[1]",
  "pool": "zakonceni_open",
  "idx": 1,
  "n": 8,
  "text": "Endaðu á staðfastri línu — nefndu hvar leitandinn stendur, ekki spurningu.",
  "chlad": 2,
  "smysl": 0,
  "slov": 40,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "zakonceni_open[2]",
  "pool": "zakonceni_open",
  "idx": 2,
  "n": 8,
  "text": "Endaðu á hljóðlátri línu sem hvílir — ekki spurningu í þetta sinn.",
  "chlad": 2,
  "smysl": 1,
  "slov": 38,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "zakonceni_heavy[0]",
  "pool": "zakonceni_heavy",
  "idx": 0,
  "n": 8,
  "text": "Endaðu á línu sem stendur — engin mjúk spurning, engin huggun; láttu það standa.",
  "chlad": 2,
  "smysl": 0,
  "slov": 38,
  "vet": "3.0"
 },
 {
  "lang": "is",
  "paka": "zakonceni_heavy[1]",
  "pool": "zakonceni_heavy",
  "idx": 1,
  "n": 8,
